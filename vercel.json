{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/handwritten/:id/:action", "destination": "/api/handwritten/[id]/[action]" },
    { "source": "/api/handwritten/", "destination": "/api/handwritten" }
  ]
}
